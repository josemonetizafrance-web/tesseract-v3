# Server Configuration
PORT=3000

# MongoDB - REEMPLAZA CON TUS CREDENCIALES
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster.mongodb.net/tesseract

# JWT Secret - Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TESS_JWT_SECRET=REEMPLAZA_ESTO_CON_CLAVE_GENERADA

# Admin Account
TESS_ADMIN_EMAIL=ChevyAdmin@tesseract.com
TESS_ADMIN_PASSWORD=AdminSegura2026*+

# Setup Secret
TESS_SETUP_SECRET=REEMPLAZA_CON_UN_SECRETO_FUERTE

# IA Services (al menos una)
# GROQ_API_KEY=...
# OPENAI_API_KEY=...
# Clave de Google AI Studio. Es la MAS BARATA y cubre texto e imagenes
# (fallback gratis de imagenes cuando OpenRouter no tiene credito).
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACK=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Modelo de OpenAI usado como ULTIMO recurso de la cascada de texto
# (OpenRouter -> Gemini -> Groq -> Venice -> OpenAI). OJO: OpenAI es de pago.
# OPENAI_MODEL=gpt-5-mini
# Respaldo si OPENAI_MODEL no existe/esta retirado (lista separada por comas).
# gpt-5-mini se apaga el 2026-12-11 -> sustitutos: gpt-5.6-terra / gpt-5.6-luna
# OPENAI_MODEL_FALLBACK=gpt-5.6-terra,gpt-5.6-luna

# IA - Imagenes (OpenRouter)
# Modelos VALIDOS (verificados en https://openrouter.ai/api/v1/models).
# Un id inexistente hace que OpenRouter responda 404 "No model found for X" y
# se caiga toda la generacion de imagenes.
#   Pro  (preset 1): google/gemini-3-pro-image
#   Lite (preset 2): google/gemini-3.1-flash-lite-image
# OPENROUTER_IMAGE_API_KEY=...
# IMAGE_MODEL=google/gemini-3-pro-image
# IMAGE_MODEL_2=google/gemini-3.1-flash-lite-image
# IMAGE_RESOLUTION=1K

# Demo & Premium Settings
TESS_DEMO_HOURS=24
TESS_PREMIUM_DAYS=90

# Rate Limiting (1 = habilitado, 0 = deshabilitado)
RATE_LIMIT_ENABLED=1
